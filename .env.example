# FPGA-Based Multilingual AI Receptionist — Environment Configuration

# Backend Inference Mode: 'auto', 'cpu', 'fpga', 'simulated_fpga'
RECEPTIONIST_BACKEND=auto

# FPGA Bitstream & MMIO Base Address (Target: PYNQ-Z2)
FPGA_BITSTREAM_PATH=fpga/bitstream/mlp_classifier.bit
FPGA_AXI_BASE_ADDR=0x43C00000

# Model and Scaler Artifact Paths
MODEL_PATH=language_classifier.pkl
SCALER_PATH=feature_scaler.pkl
KNOWLEDGE_BASE_PATH=src/knowledge_base.json

# Audio Recording & Hardware Settings
DEFAULT_SAMPLE_RATE=16000
CONFIDENCE_THRESHOLD=0.45

# Sarvam AI Voice Model Stack API Key (Preferred Cloud Voice Pipeline)
# Get your API key at: https://sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Sarvam Model Identifiers
SARVAM_STT_MODEL=saaras:v4
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v4-flash
